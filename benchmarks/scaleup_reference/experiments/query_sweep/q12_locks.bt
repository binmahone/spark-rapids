 * Licensed under the Apache License, Version 2.0.
 * Measure reclaim, spin slow paths, and scan_folios intervals separately.
 * A scan interval is not a complete or necessarily continuous lock hold.
 */
interval:s:1 /!@ready/ { printf("READY monotonic_ns=%llu\n", nsecs); @ready = 1; }

tracepoint:vmscan:mm_vmscan_direct_reclaim_begin
{
  @reclaim_begin[tid] = nsecs;
  @order[tid] = args->order;
  @reclaim_wait_ns[tid] = 0; @reclaim_waits[tid] = 0;
  @reclaim_lru_wait_ns[tid] = 0;
  @reclaim_scan_ns[tid] = 0; @reclaim_scans[tid] = 0;
  @reclaim_evict_ns[tid] = 0; @reclaim_evictions[tid] = 0;
  @reclaim_begins = count();
}
tracepoint:vmscan:mm_vmscan_direct_reclaim_end /@reclaim_begin[tid]/
{
  $end = nsecs;
  $duration = $end - @reclaim_begin[tid];
  @reclaim_duration_us = hist((uint64)$duration / 1000);
  @reclaim_ends = count();
  if ($duration > 50000000) {
    printf("RECLAIM begin_ns=%llu end_ns=%llu pid=%d tid=%d comm=%s duration_ns=%llu reclaimed=%llu order=%llu wait_ns=%llu waits=%llu lru_wait_ns=%llu scan_ns=%llu scans=%llu evict_ns=%llu evictions=%llu\n%s\n",
           @reclaim_begin[tid], $end, pid, tid, comm, $duration,
           args->nr_reclaimed, @order[tid], @reclaim_wait_ns[tid], @reclaim_waits[tid],
           @reclaim_lru_wait_ns[tid], @reclaim_scan_ns[tid], @reclaim_scans[tid], @reclaim_evict_ns[tid],
           @reclaim_evictions[tid], kstack(24));
  }
  delete(@reclaim_begin[tid]); delete(@order[tid]);
  delete(@reclaim_wait_ns[tid]); delete(@reclaim_waits[tid]);
  delete(@reclaim_lru_wait_ns[tid]);
  delete(@reclaim_scan_ns[tid]); delete(@reclaim_scans[tid]);
  delete(@reclaim_evict_ns[tid]); delete(@reclaim_evictions[tid]);
}

fentry:evict_folios
{
  $lru = args->lruvec;
  $lock = (uint64)$lru + offsetof(struct lruvec, lru_lock);
  if (@evict_begin[tid]) { @evict_reentry = count(); }
  @evict_begin[tid] = nsecs;
  @evict_lock[tid] = $lock;
  @known_lock[$lock] = 1;
  @lock_node[$lock] = $lru->pgdat->node_id;
  @evict_begins = count();
}
fexit:evict_folios /@evict_begin[tid]/
{
  $end = nsecs;
  $duration = $end - @evict_begin[tid];
  @evict_duration_us = hist((uint64)$duration / 1000);
  @evict_ends = count();
  if (@reclaim_begin[tid]) {
    @reclaim_evict_ns[tid] = @reclaim_evict_ns[tid] + $duration;
    @reclaim_evictions[tid] = @reclaim_evictions[tid] + 1;
  }
  if ($duration > 10000000) {
    printf("EVICT begin_ns=%llu end_ns=%llu pid=%d tid=%d comm=%s lock=%llx node=%d duration_ns=%llu returned=%lld\n",
           @evict_begin[tid], $end, pid, tid, comm, @evict_lock[tid],
           @lock_node[@evict_lock[tid]], $duration, retval);
  }
  delete(@evict_begin[tid]); delete(@evict_lock[tid]);
}

fentry:scan_folios
{
  $lru = args->lruvec;
  $lock = (uint64)$lru + offsetof(struct lruvec, lru_lock);
  if (@scan_begin[tid]) { @scan_reentry = count(); }
  if (@scan_active[$lock]) { @overlapping_scan_intervals = count(); }
  $begin = nsecs;
  @scan_begin[tid] = $begin;
  @scan_lock[tid] = $lock;
  @scan_candidate[$lock] = tid;
  @scan_candidate_begin[$lock] = $begin;
  @scan_active[$lock] = @scan_active[$lock] + 1;
  @scan_begins = count();
}
fexit:scan_folios /@scan_begin[tid]/
{
  $end = nsecs;
  $duration = $end - @scan_begin[tid];
  $lock = @scan_lock[tid];
  @scan_duration_us = hist((uint64)$duration / 1000);
  @scan_ends = count();
  if (@reclaim_begin[tid]) {
    @reclaim_scan_ns[tid] = @reclaim_scan_ns[tid] + $duration;
    @reclaim_scans[tid] = @reclaim_scans[tid] + 1;
  }
  if ($duration > 1000000) {
    printf("SCAN begin_ns=%llu end_ns=%llu pid=%d tid=%d comm=%s lock=%llx node=%d duration_ns=%llu returned=%lld active=%llu\n",
           @scan_begin[tid], $end, pid, tid, comm, $lock,
           @lock_node[$lock], $duration, retval, @scan_active[$lock]);
  }
  @scan_active[$lock] = @scan_active[$lock] - 1;
  if (@scan_candidate[$lock] == tid) {
    delete(@scan_candidate[$lock]); delete(@scan_candidate_begin[$lock]);
  }
  delete(@scan_begin[tid]); delete(@scan_lock[tid]);
}

fentry:native_queued_spin_lock_slowpath
/@known_lock[(uint64)args->lock]/
{
  $lock = (uint64)args->lock;
  if (@wait_begin[tid]) { @wait_reentry = count(); }
  @wait_begin[tid] = nsecs;
  @wait_lock[tid] = $lock;
  @wait_scan_candidate[tid] = @scan_candidate[$lock];
  @wait_scan_candidate_begin[tid] = @scan_candidate_begin[$lock];
  @wait_scan_active[tid] = @scan_active[$lock];
  @wait_begins = count();
}
fexit:native_queued_spin_lock_slowpath
/@known_lock[(uint64)args->lock] && @wait_begin[tid] &&
 @wait_lock[tid] == (uint64)args->lock/
{
  $end = nsecs;
  $duration = $end - @wait_begin[tid];
  $lock = @wait_lock[tid];
  @wait_duration_us = hist((uint64)$duration / 1000);
  @wait_ends = count();
  if (@reclaim_begin[tid]) {
    @reclaim_wait_ns[tid] = @reclaim_wait_ns[tid] + $duration;
    @reclaim_waits[tid] = @reclaim_waits[tid] + 1;
    if (@known_lock[$lock]) {
      @reclaim_lru_wait_ns[tid] = @reclaim_lru_wait_ns[tid] + $duration;
    }
  }
  @wait_ns_by_lock[$lock] = sum($duration);
  @wait_max_ns_by_lock[$lock] = max($duration);
  if ($duration > 1000000) {
    printf("LOCK_WAIT begin_ns=%llu end_ns=%llu pid=%d tid=%d comm=%s lock=%llx known_lru=%d node=%d duration_ns=%llu scan_candidate_tid=%llu scan_candidate_begin_ns=%llu scan_active_at_begin=%llu\n%s\n",
           @wait_begin[tid], $end, pid, tid, comm, $lock, @known_lock[$lock],
           @lock_node[$lock], $duration, @wait_scan_candidate[tid],
           @wait_scan_candidate_begin[tid], @wait_scan_active[tid], kstack(24));
  }
  delete(@wait_begin[tid]); delete(@wait_lock[tid]);
  delete(@wait_scan_candidate[tid]); delete(@wait_scan_candidate_begin[tid]);
  delete(@wait_scan_active[tid]);
}
