 * Capture direct reclaim durations; counts are events, not elapsed query time.
 */
/* Interval probes avoid the stripped BEGIN/END symbols in Ubuntu's package. */
interval:s:1 /!@ready/ { printf("READY monotonic_ns=%llu\n", nsecs); @ready = 1; }
tracepoint:vmscan:mm_vmscan_direct_reclaim_begin
{
  @begin[tid] = nsecs;
  @origin[tid] = kstack(24);
  @order[tid] = args->order;
  @gfp[tid] = args->gfp_flags;
  @begins = count();
}
tracepoint:vmscan:mm_vmscan_direct_reclaim_end
/@begin[tid]/
{
  $duration = nsecs - @begin[tid];
  @duration_us = hist($duration / 1000);
  @ends = count();
  if ($duration > 50000000) {
    printf("SLOW begin_ns=%llu end_ns=%llu pid=%d tid=%d comm=%s duration_ns=%llu reclaimed=%llu order=%llu gfp=%llu\n%s\n",
           @begin[tid], nsecs, pid, tid, comm, $duration, args->nr_reclaimed,
           @order[tid], @gfp[tid], @origin[tid]);
  }
  delete(@begin[tid]); delete(@origin[tid]); delete(@order[tid]); delete(@gfp[tid]);
}
/* bpftrace prints the final maps automatically on a graceful stop. */
