#SBATCH --job-name=mahonem-kvikio-q6-build
#SBATCH --partition=nvidia-part
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=24
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --time=00:30:00
set -euo pipefail
export KVIKIO_SOURCE_REVISION=${KVIKIO_SOURCE_REVISION:?}
/cm/local/apps/slurm/current/bin/srun --kill-on-bad-exit=1 \
  --container-image=nvcr.io#nvidia/cuda:13.1.0-base-ubuntu24.04 \
  --container-mounts=/home/mahonem:/home/mahonem,/home/prestouser:/home/prestouser,/usr/local/cuda-13.0/include:/host-cuda-include:ro \
  --container-remap-root --container-writable \
  bash /home/mahonem/paul_q6_kvikio_261110/src/cudf-spark/experiments/kvikio-q6-261110/build.sh
